# DeepSeek API key (required for all LLM-powered commands)
DEEPSEEK_API_KEY=sk-...

# Optional integrations (gated — commands exit cleanly when unset)
# Notion:
NOTION_TOKEN=secret_...
NOTION_PARENT_PAGE_ID=...
# Gmail:
GMAIL_CREDENTIALS_PATH=gmail_sync/credentials.json
GMAIL_TOKEN_PATH=gmail_sync/token.json
